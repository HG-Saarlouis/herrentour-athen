    <Placemark>
      <name>[01] BIOS</name>
      <description><![CDATA[<b>ROOFTOP / LATE NIGHT — Psyri / West</b><br/><b>Adresse:</b> Pireos 84, 104 35 Athen (400 m · 5 Min. ab Apartment)<br/><b>Voraussichtliche Zeiten:</b> Tägl. 10:00–02:00 (Fr/Sa bis 03:00)<br/><b>Essen:</b> SNACKS ONLY (Reine Bar — kein Abendessen (nur Bar-Snacks))<br/><b>Bestellung:</b> Papoto-Slush (Eis am Stiel im Cocktailglas) & kaltes Fassbier<br/><b>Insider:</b> Eingang um die Ecke auf der Salaminos 13 nutzen · Aufzug direkt in den 2. Stock / aufs Dach · Liegestühle mit unverbautem Blick auf die beleuchtete Akropolis.<br/><a href='https://www.google.com/maps/search/?api=1&query=Bios+Athens&query_place_id=ChIJ_cOT3CC9oRQRcZdnJp_dsRA'>Google Maps öffnen</a>]]></description>
      <Point><coordinates>23.71915,37.97918,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>[02] UPUPA EPOPS</name>
      <description><![CDATA[<b>COCKTAILS / HOF & BARFOOD — Petralona</b><br/><b>Adresse:</b> Alkminis 7, 118 54 Kato Petralona (1,6 km · 20 Min. ab Apartment)<br/><b>Voraussichtliche Zeiten:</b> Tägl. 10:00–02:00 (Fr/Sa bis 03:00)<br/><b>Essen:</b> BARFOOD / PIZZA (Starkes Barfood & Sauerteig-Pizza (Küche bis 00:30))<br/><b>Bestellung:</b> Upupa Epops Signature Cocktail & Trüffel-Pilz-Pinsa<br/><b>Insider:</b> Drei zusammengefügte 1930er-Steinhäuser · Perfekt als Start der Donnerstag-West-Linie vor Line Athens (nur 400 m weiter).<br/><a href='https://www.google.com/maps/search/?api=1&query=Upupa+Epops+Athens&query_place_id=ChIJ6aOwMeG8oRQRtecCV4GFOvY'>Google Maps öffnen</a>]]></description>
      <Point><coordinates>23.71184,37.97152,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>[03] LINE ATHENS</name>
      <description><![CDATA[<b>WORLD'S 50 BEST / AVANTGARDE — Petralona</b><br/><b>Adresse:</b> Agathodaimonos 37, 118 53 Kato Petralona (1,7 km · 22 Min. ab Apartment)<br/><b>Voraussichtliche Zeiten:</b> Mo–Do 17:00–02:00 · Fr 17:00–03:00 · Sa/So ab 10:30<br/><b>Essen:</b> GASTRO BARFOOD (Hauseigene Sauerteig-Bäckerei & Zero-Waste-Gerichte)<br/><b>Bestellung:</b> Hauseigene Fruchtweine ('Why Not' Erdbeer/Feige/Granatapfel) & 'Line's Hot Dog'<br/><b>Insider:</b> Ehemalige Kunstgalerie in alter Fabrik · Ab 21:30 Uhr legt der DJ auf · 5 Min. Fußweg von Upupa Epops.<br/><a href='https://www.google.com/maps/search/?api=1&query=Line+Athens&query_place_id=ChIJ13n7hoG9oRQRXHgFVrMGEGU'>Google Maps öffnen</a>]]></description>
      <Point><coordinates>23.70995,37.96885,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>[04] TAF (THE ART FOUNDATION)</name>
      <description><![CDATA[<b>HIDDEN COURTYARD / ART BAR — Monastiraki / Psyri</b><br/><b>Adresse:</b> Normanou 5, 105 55 Monastiraki (800 m · 10 Min. ab Apartment)<br/><b>Voraussichtliche Zeiten:</b> Mo–Do 11:00–02:00 · Fr/Sa bis 03:00<br/><b>Essen:</b> DRINKS ONLY (Reine Bar & Café — vorab in Psyri essen!)<br/><b>Bestellung:</b> Freddo Espresso tagsüber · Klassische Highballs & Gin-Drinks nachts<br/><b>Insider:</b> Durch den dunklen Torbogen auf der Flohmarktgasse Normanou 5 gehen · Couleur Locale ist direkt im Gebäude daneben (Normanou 3)!<br/><a href='https://www.google.com/maps/search/?api=1&query=TAF+The+Art+Foundation+Athens&query_place_id=ChIJk4XyViK9oRQRz5_VHhupvS8'>Google Maps öffnen</a>]]></description>
      <Point><coordinates>23.72438,37.97622,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>[05] COULEUR LOCALE</name>
      <description><![CDATA[<b>ROOFTOP / SUNSET VIEW — Monastiraki</b><br/><b>Adresse:</b> Normanou 3, 105 55 Monastiraki (800 m · 10 Min. ab Apartment)<br/><b>Voraussichtliche Zeiten:</b> Tägl. 09:30–02:00 (Fr/Sa bis 03:00)<br/><b>Essen:</b> BRUNCH & BARFOOD (Brunch bis 18:00, danach Burger/Pinsa/Fingerfood)<br/><b>Bestellung:</b> Mediterranean Mule & Akropolis-Sundowner um 17:00 Uhr<br/><b>Insider:</b> In die unscheinbare Ladenpassage Normanou 3 hineingehen und den Aufzug in den 3. Stock nehmen · Im November mit Glas-Windschutz & Heizstrahlern.<br/><a href='https://www.google.com/maps/search/?api=1&query=Couleur+Locale+Athens&query_place_id=ChIJYzvSVSK9oRQRXdJTkbjBNUs'>Google Maps öffnen</a>]]></description>
      <Point><coordinates>23.72452,37.97628,0</coordinates></Point>
